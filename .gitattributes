# Normalise text files to LF (ES-03)
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.xlsx binary
*.jar binary
*.zip binary
*.gz binary

# Wrapper scripts must keep their line endings
mvnw text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
