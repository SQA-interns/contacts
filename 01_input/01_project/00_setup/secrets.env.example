# Every secret, key, account or external service credential the project needs.
# Owner: Architect. Agent: read-only.
# The human copies this file to .env (ignored by git) and fills the values; the agent checks .env in phase 0.
# Above each key, one comment line: purpose; environments; provided | test-mode only | not needed.
# Names only. Never write a value in this file, in chat or in a commit (Q-48, Q-49).

# PostgreSQL database name; local, production; provided
POSTGRES_DB=
# PostgreSQL user of the application; local, production; provided
POSTGRES_USER=
# PostgreSQL password of the application; local, production; provided
POSTGRES_PASSWORD=
# Firebase project id used by the backend to check ID tokens; local (development project), production (customer's project); provided
FIREBASE_PROJECT_ID=
# Firebase web API key used by the front end to sign in (an identifier of the Firebase project, kept out of the repository anyway); local, production; provided
VITE_FIREBASE_API_KEY=
# Firebase auth domain used by the front end; local, production; provided
VITE_FIREBASE_AUTH_DOMAIN=
# Address of the Firebase Authentication emulator, for example localhost:9099 (not a secret); test, local; test-mode only
FIREBASE_AUTH_EMULATOR_HOST=
# Google service-account file for Firebase Admin APIs; none; not needed (checking ID tokens needs only the project id)
GOOGLE_APPLICATION_CREDENTIALS=
